# ── Speech transcription (No billing: local Whisper via Docker) ─────────────
# Run this first in a separate terminal:
# npm run dev:whisper
#
# Keep OPENAI_API_KEY empty for free/local mode.
OPENAI_API_KEY=
WHISPER_API_URL=http://127.0.0.1:9000/asr?task=transcribe&output=json
WHISPER_BEARER_TOKEN=
WHISPER_FILE_FIELD=audio_file

# ── Translation provider ─────────────────────────────────────────────────────
# TRANSLATION_PROVIDER=mymemory   (default, free, no key needed)
# TRANSLATION_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=http://localhost:5000/translate
# LIBRETRANSLATE_API_KEY=

# ── Server / client URLs ─────────────────────────────────────────────────────
VITE_ENABLE_WHISPER_FALLBACK=true
VITE_SOCKET_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Summary mode: deterministic | semantic-lite
SUMMARY_MODE=deterministic
VITE_SUMMARY_MODE=deterministic

PORT=3000
